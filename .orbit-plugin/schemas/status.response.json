{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision-mail.status response",
  "type": "object",
  "properties": {
    "version": { "type": "string", "description": "The plugin version answering the call." },
    "transport": {
      "type": "string",
      "enum": ["ready", "not_configured"],
      "description": "`ready` when every required config key and secret is set and the config is valid; otherwise `not_configured`."
    },
    "secrets": {
      "type": "object",
      "description": "Each declared secret name mapped to whether Orbit delivered a value. Never a value.",
      "properties": {
        "smtp_password": { "$ref": "#/$defs/presence" },
        "imap_password": { "$ref": "#/$defs/presence" },
        "channel_key": { "$ref": "#/$defs/presence" }
      },
      "required": ["smtp_password", "imap_password", "channel_key"],
      "additionalProperties": false
    },
    "missing": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Names of required config keys and secrets that are not set."
    },
    "config_error": {
      "type": "string",
      "description": "Why the config is invalid, naming the key; present only when it is."
    },
    "channel": { "type": "string", "description": "The decision channel name submissions use." },
    "key_epoch": {
      "description": "The configured channel key epoch tokens are minted under.",
      "type": ["integer", "null"]
    },
    "activity": {
      "type": "object",
      "description": "Recent activity from plugin state.",
      "properties": {
        "last_notify": { "type": ["object", "null"] },
        "last_poll": { "type": ["object", "null"] },
        "last_digest": { "type": ["object", "null"] },
        "pending_confirmations": {
          "type": "integer",
          "minimum": 0,
          "description": "Applied digest answers waiting for the next digest to confirm them."
        },
        "last_error": { "type": ["object", "null"] },
        "notified_requests": { "type": "integer", "minimum": 0 },
        "recent_drops": {
          "type": "array",
          "description": "The latest dropped mails: sender, reason and the provider's verdicts.",
          "items": { "type": "object" }
        },
        "counters": { "$ref": "#/$defs/counters" },
        "events": { "$ref": "#/$defs/events" },
        "bound": {
          "type": "integer",
          "const": 20,
          "description": "How many events are kept. Older events are evicted first."
        }
      },
      "required": [
        "last_notify",
        "last_poll",
        "last_digest",
        "last_error",
        "pending_confirmations",
        "notified_requests",
        "recent_drops",
        "counters",
        "events",
        "bound"
      ],
      "additionalProperties": false
    }
  },
  "required": ["version", "transport", "secrets", "missing", "channel", "key_epoch", "activity"],
  "additionalProperties": false,
  "$defs": {
    "presence": { "type": "string", "enum": ["set", "unset"] },
    "counters": {
      "type": "object",
      "description": "Cumulative counts for the life of the state file. Keys are plugin reason codes.",
      "properties": {
        "drops": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "refusals": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "transport": {
          "type": "object",
          "properties": {
            "smtp": { "type": "integer", "minimum": 0 },
            "imap": { "type": "integer", "minimum": 0 }
          },
          "required": ["smtp", "imap"],
          "additionalProperties": false
        },
        "loop_guard": { "type": "integer", "minimum": 0 }
      },
      "required": ["drops", "refusals", "transport", "loop_guard"],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "description": "The newest events, oldest first within the bound. No body, token, secret or header.",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string" },
          "kind": { "type": "string", "enum": ["drop", "refusal", "transport", "loop_guard"] },
          "reason": { "type": "string" },
          "sender": { "type": ["string", "null"] },
          "request_id": { "type": ["string", "null"] }
        },
        "required": ["at", "kind", "reason", "sender", "request_id"],
        "additionalProperties": false
      }
    }
  }
}
